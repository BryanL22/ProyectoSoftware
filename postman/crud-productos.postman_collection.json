          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mouse inalámbrico\",\n  \"descripcion\": \"Mouse óptico de 1600 dpi\",\n  \"categoria\": \"Accesorios\",\n  \"precio\": 40000,\n  \"stock\": 30\n}"
