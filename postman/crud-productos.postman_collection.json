{
  "info": {
    "name": "CRUD Productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"descripcion\": \"Teclado USB con switches azules\",\n  \"categoria\": \"Accesorios\",\n  \"precio\": 185000,\n  \"stock\": 12\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"El producto se crea con estado 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"productoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 con una lista\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"descripcion\": \"Teclado USB con switches azules\",\n  \"categoria\": \"Accesorios\",\n  \"precio\": 179000,\n  \"stock\": 8\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 con el stock actualizado\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().stock).to.eql(8);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear producto inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"precio\": -1,\n  \"stock\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 400 por datos inválidos\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar producto eliminado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "productoId",
      "value": ""
    }
  ]
}