      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 409 por nombre repetido\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 con una lista\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar ordenado por precio descendente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos?orden=precio&direccion=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ],
          "query": [
            {
              "key": "orden",
              "value": "precio"
            },
            {
              "key": "direccion",
              "value": "desc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Los precios quedan de mayor a menor\", function () {",
              "    pm.response.to.have.status(200);",
              "    const precios = pm.response.json().map(p => Number(p.precio));",
              "    const ordenados = [...precios].sort((a, b) => b - a);",
              "    pm.expect(precios).to.eql(ordenados);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar ordenado por nombre",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos?orden=nombre&direccion=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ],
          "query": [
            {
              "key": "orden",
              "value": "nombre"
            },
            {
              "key": "direccion",
              "value": "asc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Los nombres quedan en orden alfabético\", function () {",
              "    pm.response.to.have.status(200);",
              "    const nombres = pm.response.json().map(p => p.nombre.toLowerCase());",
              "    const ordenados = [...nombres].sort((a, b) => a.localeCompare(b));",
              "    pm.expect(nombres).to.eql(ordenados);",
              "});"
            ]
          }
        }
      ]
    },
